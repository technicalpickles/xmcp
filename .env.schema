# Varlock schema: secrets come from Automic Vault, nothing secret lives in this file.
# One-time: `mise run setup`, then `av save --project-directory=. X_OAUTH2_CLIENT_ID`
# (and X_OAUTH2_CLIENT_SECRET). 1Password stays the long-term store; `av save`
# is where the value gets loaded for local use.
#
# The plugin is pinned to a fixed version. The first fetch of a third-party plugin
# needs an interactive confirmation (`mise run setup`); after that it is cached.
# @plugin(@automic-vault/varlock-plugin@0.1.0)
# @disableProcessEnvInjection
# @defaultSensitive=false
# ---

# OAuth2 Client ID and Secret from the X developer portal (not the API/consumer keys).
# The ID is embedded in the authorize URL, so it must not be @sensitive (that would
# redact it from the printed link and make the link unusable). Items are
# non-sensitive by default here (@defaultSensitive=false); only the secret opts in.
# @required
X_OAUTH2_CLIENT_ID=av()

# @sensitive @required
X_OAUTH2_CLIENT_SECRET=av()

# OrbStack hostname for the container (not a secret). Reachable at
# http://$XMCP_ORB_DOMAIN/mcp on this machine only.
XMCP_ORB_DOMAIN=xmcp.local

# Read-only tool surface exposed by the MCP server. Trimmed to reading tweets +
# your own timeline / mentions / bookmarks. Aligns with the requested scopes
# (tweet.read users.read bookmark.read like.read follows.read).
X_API_TOOL_ALLOWLIST=getUsersMe,getUsersByUsername,getUsersByUsernames,getUsersById,getUsersByIds,getUsersPosts,getUsersMentions,getUsersTimeline,getUsersLikedPosts,getUsersBookmarks,getUsersBookmarkFolders,getUsersBookmarksByFolderId,searchPostsRecent,getPostsById,getPostsByIds,getPostsCountsRecent,getUsersFollowers,getUsersFollowing,getPostsLikingUsers,getPostsRepostedBy,getPostsReposts,getPostsQuotedPosts
