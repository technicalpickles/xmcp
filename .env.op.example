# Copy to .env.op and point these at your 1Password item fields, then run:
#   op run --env-file=.env.op -- docker compose up -d xmcp
#
# .env.op holds ONLY op:// references (no secret values), so it is safe to keep
# locally. It is gitignored anyway. op resolves these into the process env at
# launch; nothing secret touches disk or the image.

X_OAUTH2_CLIENT_ID=op://VAULT/ITEM/client_id
X_OAUTH2_CLIENT_SECRET=op://VAULT/ITEM/client_secret

# Optional: a refresh-token seed used only when the docker token volume is empty.
# The live token rotates and lives in the volume, so this is just a bootstrap.
X_OAUTH2_REFRESH_TOKEN=op://VAULT/ITEM/refresh_token

# OrbStack hostname for the container (plain value, not a secret). Override to
# taste; reachable at http://$XMCP_ORB_DOMAIN/mcp on this machine only.
XMCP_ORB_DOMAIN=xmcp.local

# Read-only tool surface exposed by the MCP server. Trimmed to reading tweets +
# your own timeline / mentions / bookmarks. Aligns with the requested scopes
# (tweet.read users.read bookmark.read like.read follows.read).
X_API_TOOL_ALLOWLIST=getUsersMe,getUsersByUsername,getUsersByUsernames,getUsersById,getUsersByIds,getUsersPosts,getUsersMentions,getUsersTimeline,getUsersLikedPosts,getUsersBookmarks,getUsersBookmarkFolders,getUsersBookmarksByFolderId,searchPostsRecent,getPostsById,getPostsByIds,getPostsCountsRecent,getUsersFollowers,getUsersFollowing,getPostsLikingUsers,getPostsRepostedBy,getPostsReposts,getPostsQuotedPosts
